```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Test coverage and temporary files
.pytest_cache/
.coverage
coverage/
htmlcov/

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Build and distribution directories
build/
dist/
*.egg-info/
```